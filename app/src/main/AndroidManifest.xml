<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>


    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:forceDarkAllowed="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DiabetesEducation"
        tools:targetApi="31">
        <receiver
            android:name=".notifications.CheckReminderReceiver"
            android:exported="false"/>
        <activity
            android:name=".presentation.MainActivity"
            android:theme="@style/Theme.DiabetesEducation.Splash"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
        </activity>

        <activity
            android:name="sdk.pendo.io.activities.PendoGateActivity"
            android:exported="true"
            android:launchMode="singleInstance">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="pendo-224f5f50" />
            </intent-filter>
        </activity>

        <!-- Default launcher icon, enabled by default. -->
        <activity-alias
            android:name=".presentation.MainActivityDefault"
            android:targetActivity=".presentation.MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Halloween launcher icon, toggled on by the halloweenTheme Remote Config flag. -->
        <activity-alias
            android:name=".presentation.MainActivityHalloween"
            android:targetActivity=".presentation.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_logo_halloween"
            android:roundIcon="@mipmap/ic_logo_halloween_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>